# --- Database (Cloudflare D1) ---
# Created with: npx wrangler d1 create crypto-bot-platform-db
# Reached via Cloudflare's REST API, authenticated using the OAuth token from
# `npx wrangler login` (must be run once on this machine) - no separate API token needed.
D1_DATABASE_NAME=crypto-bot-platform-db
CLOUDFLARE_ACCOUNT_ID=change_me
CLOUDFLARE_D1_DATABASE_ID=change_me

# --- Redis (or Memurai, a Redis-compatible server, when running natively on Windows) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_super_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
